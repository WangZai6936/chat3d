# Optional organization restriction only. Leave UNSET for safe custom public HTTPS APIs.
# CHAT3D_ALLOWED_UPSTREAMS=https://approved-provider.example/v1
# Never put API keys in VITE_* variables, source files or Docker images.
# Behind an HTTPS reverse proxy set the external page origin:
# CHAT3D_PUBLIC_ORIGIN=https://chat3d.example.com
# Optional Node-only copy of the same Tauri latest.json. Not the desktop client's URL.
# CHAT3D_DESKTOP_UPDATE_MANIFEST=/opt/1panel/www/sites/portal.jiezi-ai.com/index/desktop-updates/chat3d/latest.json
# Build-time release notes baked into dist/version.json and the desktop manifest. Do not put secrets here:
# CHAT3D_UPDATE_NOTES=
# CHAT3D_UPDATE_PUB_DATE=2026-10-26T00:00:00Z
# Desktop release build only. Public values; keep the private key out of the repo.
# Portal static manifest (origin listens on 38008 behind Cloudflare Tunnel):
# CHAT3D_UPDATER_ENDPOINT=https://portal.jiezi-ai.com/desktop-updates/chat3d/latest.json
# Optional bare-IP HTTP origin for installer URLs in latest.json only (no trailing slash). Check endpoint stays HTTPS above.
# CHAT3D_UPDATER_DOWNLOAD_ORIGIN=http://36.133.218.210:38008
# Optional extra installer origins, comma-separated, no path or trailing slash. Portal publishes also list the other of the Cloudflare/direct pair in `mirrors`.
# CHAT3D_UPDATER_DOWNLOAD_MIRRORS=https://downloads.example.com
# CHAT3D_UPDATER_PUBKEY=
# TAURI_SIGNING_PRIVATE_KEY=
# Team library platform SSO (path A). Server only forwards the user access token.
# CHAT3D_PLATFORM_AUTH_BASE=http://36.133.218.210:48080
# CHAT3D_PLATFORM_TENANT_ID=1
# Set to 0 to reject local team password login with 403.
# CHAT3D_TEAM_PASSWORD_LOGIN=1
# OAuth authorization_code (client_id public; secret server-only — never commit):
# CHAT3D_PLATFORM_OAUTH_CLIENT_ID=scenivo
# CHAT3D_PLATFORM_OAUTH_CLIENT_SECRET=
# or: CHAT3D_PLATFORM_OAUTH_CLIENT_SECRET_FILE=/path/to/scenivo-oauth2-client-secret.txt
# CHAT3D_PLATFORM_OAUTH_TOKEN_PATH=/admin-api/system/oauth2/token
# Collaborative SSO UI (Vue hash router → Scenivo opens {BASE}/#/sso?…):
# CHAT3D_PLATFORM_SSO_UI_BASE=http://36.133.218.210:48001
# Desktop/web build-time defaults (Vite):
# VITE_CHAT3D_TEAM_DEFAULT_BASE=https://portal.jiezi-ai.com
# VITE_CHAT3D_TEAM_SHOW_PASSWORD_LOGIN=0
# VITE_CHAT3D_PLATFORM_AUTH_BASE=http://36.133.218.210:48080
# VITE_CHAT3D_PLATFORM_OAUTH_CLIENT_ID=scenivo
# VITE_CHAT3D_PLATFORM_SSO_UI_BASE=http://36.133.218.210:48001
# VITE_CHAT3D_PLATFORM_OAUTH_REDIRECT_URI=https://portal.jiezi-ai.com/team/sso/callback
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
