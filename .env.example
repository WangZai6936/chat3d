# Server-only trusted API roots. Defaults already include the reported provider and OpenAI.
# Never put API keys in VITE_* variables, source files, Docker images or this file.
CHAT3D_ALLOWED_UPSTREAMS=https://discovery-api.intern-ai.org.cn/v1,https://api.openai.com/v1
# For Node behind an HTTPS reverse proxy, set the externally visible page origin:
# CHAT3D_PUBLIC_ORIGIN=https://chat3d.example.com
